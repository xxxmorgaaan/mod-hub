<% if (yandexAdBlockId) { %>
<!-- Рекламный блок Яндекса (РСЯ) — один на страницу, внизу. Появляется
     только когда задан YANDEX_AD_BLOCK_ID в .env; пока не задан, здесь
     ничего не выводится и посторонние скрипты не грузятся. -->
<div class="container ad-slot">
  <div id="yandex_rtb_<%= yandexAdBlockId %>"></div>
  <script>window.yaContextCb = window.yaContextCb || [];</script>
  <script src="https://yandex.ru/ads/system/context.js" async></script>
  <script>
    window.yaContextCb.push(function () {
      Ya.Context.AdvManager.render({
        blockId: <%- JSON.stringify(yandexAdBlockId) %>,
        renderTo: 'yandex_rtb_<%= yandexAdBlockId %>'
      });
    });
  </script>
</div>
<% } %>

<footer class="site-footer">
  <div class="container foot-row">
    <div>
      <span class="foot-credit" id="footerAdminTrigger">Сделал <b><%= siteAuthorName %></b> · Telegram: <a href="https://t.me/<%= siteAuthorTelegram.replace('@','') %>" target="_blank" rel="noopener"><%= siteAuthorTelegram %></a></span>
    </div>
    <div>
      Alem Colony — Telegram-канал разработчика игры:
      <a href="https://t.me/<%= gameDevTelegram.replace('@','') %>" target="_blank" rel="noopener"><%= gameDevTelegram %></a>
    </div>
    <div>
      <a href="/mods/new">Опубликовать мод</a> ·
      <a href="/games/alem-colony/bundles">Сборки</a> ·
      <% if (bugsEnabled) { %><a href="/bugs">Баг-репорты</a> ·<% } %>
      <a href="/manage.html">🔑 Управление по коду</a>
    </div>
  </div>
</footer>
<script src="/js/main.js"></script>
